{
  "name": "datadog-migrator",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test src/tests/",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile dist/datadog-migrator",
    "build:all": "bun run build:mac && bun run build:mac-arm && bun run build:linux && bun run build:windows",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-x64 --outfile dist/datadog-migrator-macos-x64",
    "build:mac-arm": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile dist/datadog-migrator-macos-arm64",
    "build:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile dist/datadog-migrator-linux-x64",
    "build:windows": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/datadog-migrator-win-x64.exe"
  },
  "dependencies": {
    "@datadog/datadog-api-client": "1.34.1",
    "boxen": "8.0.1",
    "commander": "13.1.0",
    "figlet": "1.8.1",
    "inquirer": "12.5.2",
    "kleur": "4.1.5",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.3.13",
    "@types/figlet": "1.7.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2"
  }
}
