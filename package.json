{
  "name": "datadog-migrator",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test src/tests/",
    "build": "bun build src/index.ts --compile --outfile dist/datadog-migrator",
    "build:all": "scripts/build-all.sh"
  },
  "dependencies": {
    "@datadog/datadog-api-client": "1.34.1",
    "boxen": "8.0.1",
    "commander": "13.1.0",
    "figlet": "1.8.1",
    "inquirer": "12.5.2",
    "kleur": "4.1.5",
    "ora": "8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.3",
    "@types/figlet": "1.7.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2"
  }
}
