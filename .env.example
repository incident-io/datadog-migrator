# Datadog API credentials
DATADOG_API_KEY=your_api_key_here
DATADOG_APP_KEY=your_app_key_here
# Datadog site (default: datadoghq.com — set for EU: datadoghq.eu, US3: us3.datadoghq.com, etc.)
# DATADOG_SITE=datadoghq.com

# Incident.io webhook credentials
INCIDENTIO_WEBHOOK_TOKEN=your_webhook_token_here